<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 1. Shared Preferences -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1. Shared Preferences (Key-Value)"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etPrefName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter name to save" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnSavePref"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Save" />
            <Button
                android:id="@+id/btnLoadPref"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Load" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrefResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Loaded: None"
            android:padding="8dp" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDD" android:layout_marginVertical="20dp"/>

        <!-- 2. SQLite Database -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2. SQLite Database (Structured)"
            android:textStyle="bold"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etSqlName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="User Name" />

        <EditText
            android:id="@+id/etSqlId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="User ID (for Update/Delete)"
            android:inputType="number" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">
            <Button android:id="@+id/btnSqlAdd" android:layout_width="wrap_content" android:text="Add User" />
            <Button android:id="@+id/btnSqlView" android:layout_width="wrap_content" android:text="View All" />
            <Button android:id="@+id/btnSqlUpdate" android:layout_width="wrap_content" android:text="Update" />
            <Button android:id="@+id/btnSqlDelete" android:layout_width="wrap_content" android:text="Delete" />
        </GridLayout>

    </LinearLayout>
</ScrollView>